{
	"name": "relay-flare",
	"version": "0.1.0",
	"private": true,
	"description": "Precise real-time Obsidian sync and collaboration on your own Cloudflare account.",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:server": "npm --prefix server test",
		"test:all": "npm test && npm run test:server",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"license": "MIT",
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"fast-diff": "1.3.0",
		"fflate": "0.8.3",
		"idb": "8.0.4",
		"lib0": "0.2.119",
		"monkey-around": "3.0.0",
		"node-diff3": "3.2.1",
		"qrcode-generator": "2.0.4",
		"y-codemirror.next": "0.3.6",
		"y-protocols": "1.0.7",
		"yjs": "13.6.33"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "9.39.1",
		"@types/node": "22.19.1",
		"esbuild": "0.28.2",
		"eslint": "9.39.1",
		"eslint-plugin-obsidianmd": "0.4.2",
		"fake-indexeddb": "6.2.6",
		"fast-check": "4.10.2",
		"obsidian": "1.14.4",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vitest": "4.1.12"
	}
}
